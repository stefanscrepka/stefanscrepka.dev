{
  "ci": {
    "collect": {
      "url": [
        "http://localhost:3000",
        "http://localhost:3000/work",
        "http://localhost:3000/work/content-engine",
        "http://localhost:3000/process",
        "http://localhost:3000/privacidade"
      ],
      "startServerCommand": "pnpm start",
      "startServerReadyPattern": "Ready in",
      "numberOfRuns": 3,
      "settings": {
        "preset": "desktop",
        "chromeFlags": "--no-sandbox --headless=new"
      }
    },
    "assert": {
      "preset": "lighthouse:recommended",
      "assertions": {
        "categories:performance": ["error", { "minScore": 0.9 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.95 }],
        "categories:seo": ["error", { "minScore": 0.95 }],

        "csp-xss": "warn",
        "uses-text-compression": "off",
        "redirects-http": "off",
        "uses-responsive-images": "warn",
        "uses-rel-preconnect": "warn",

        "color-contrast": "warn",
        "bf-cache": "warn",
        "errors-in-console": "warn",
        "unminified-javascript": "off",
        "unused-javascript": "warn",
        "valid-source-maps": "warn",
        "legacy-javascript": "warn",
        "legacy-javascript-insight": "off",

        "largest-contentful-paint": "warn",
        "speed-index": "warn",
        "mainthread-work-breakdown": "warn",
        "max-potential-fid": "warn",
        "dom-size": "warn",
        "dom-size-insight": "off",
        "uses-long-cache-ttl": "warn",
        "lcp-discovery-insight": "warn",
        "network-dependency-tree-insight": "off",
        "forced-reflow-insight": "warn",
        "render-blocking-insight": "warn",
        "document-latency-insight": "off",
        "duplicated-javascript-insight": "warn",
        "font-display-insight": "warn",
        "image-delivery-insight": "warn",
        "interaction-to-next-paint-insight": "warn",
        "lcp-lazy-loaded": "warn",
        "lcp-phases-insight": "warn",
        "modern-http-insight": "off",
        "non-composited-animations": "warn",
        "prioritize-lcp-image": "warn",
        "third-parties-insight": "off",
        "viewport-insight": "warn",
        "cls-culprits-insight": "warn"
      }
    },
    "upload": {
      "target": "temporary-public-storage"
    }
  }
}
