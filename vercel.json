{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "nextjs",
  "buildCommand": "pnpm build",
  "devCommand": "pnpm dev",
  "installCommand": "pnpm install --frozen-lockfile",
  "outputDirectory": ".next",
  "regions": ["gru1"],
  "functions": {
    "app/**": { "maxDuration": 10 }
  },
  "cleanUrls": true,
  "trailingSlash": false
}
